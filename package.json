{
  "name": "clear-my-fridge",
  "version": "0.1.0",
  "private": true,
  "description": "Keep track of what is in your fridge and what expires first.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
